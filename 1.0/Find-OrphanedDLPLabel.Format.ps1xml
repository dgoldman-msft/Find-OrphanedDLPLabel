<?xml version="1.0" encoding="utf-8"?>
<Configuration>
  <ViewDefinitions>
    <View>
      <Name>Find.OrphanedDLPLabel.Result</Name>
      <ViewSelectedBy>
        <TypeName>Find.OrphanedDLPLabel.Result</TypeName>
      </ViewSelectedBy>
      <ListControl>
        <ListEntries>
          <ListEntry>
            <ListItems>
              <ListItem>
                <PropertyName>LabelGuid</PropertyName>
              </ListItem>
              <ListItem>
                <PropertyName>IsOrphaned</PropertyName>
              </ListItem>
              <ListItem>
                <PropertyName>Findings</PropertyName>
              </ListItem>
              <ListItem>
                <PropertyName>Label</PropertyName>
              </ListItem>
              <ListItem>
                <PropertyName>AutoLabelRules</PropertyName>
              </ListItem>
              <ListItem>
                <PropertyName>DlpRules</PropertyName>
              </ListItem>
              <ListItem>
                <Label>AuditRecords</Label>
                <ScriptBlock>$_.AuditRecords.ToString()</ScriptBlock>
              </ListItem>
              <ListItem>
                <PropertyName>ComplianceSearch</PropertyName>
              </ListItem>
              <ListItem>
                <PropertyName>Errors</PropertyName>
              </ListItem>
              <ListItem>
                <PropertyName>LogPath</PropertyName>
              </ListItem>
            </ListItems>
          </ListEntry>
        </ListEntries>
      </ListControl>
    </View>
    <View>
      <Name>Find.OrphanedDLPLabel.AuditRecord</Name>
      <ViewSelectedBy>
        <TypeName>Find.OrphanedDLPLabel.AuditRecord</TypeName>
      </ViewSelectedBy>
      <TableControl>
        <TableHeaders>
          <TableColumnHeader>
            <Label>CreationTime</Label>
            <Width>20</Width>
          </TableColumnHeader>
          <TableColumnHeader>
            <Label>Operation</Label>
            <Width>28</Width>
          </TableColumnHeader>
          <TableColumnHeader>
            <Label>Target</Label>
            <Width>28</Width>
          </TableColumnHeader>
          <TableColumnHeader>
            <Label>LabelGuid</Label>
            <Width>36</Width>
          </TableColumnHeader>
          <TableColumnHeader>
            <Label>LabelEvidence</Label>
          </TableColumnHeader>
        </TableHeaders>
        <TableRowEntries>
          <TableRowEntry>
            <TableColumnItems>
              <TableColumnItem>
                <PropertyName>CreationTime</PropertyName>
              </TableColumnItem>
              <TableColumnItem>
                <PropertyName>Operation</PropertyName>
              </TableColumnItem>
              <TableColumnItem>
                <ScriptBlock>
                  if ($_.Subject) {
                      $_.Subject
                  }
                  elseif ($_.FileName) {
                      $_.FileName
                  }
                  else {
                      $_.ObjectId
                  }
                </ScriptBlock>
              </TableColumnItem>
              <TableColumnItem>
                <PropertyName>LabelGuid</PropertyName>
              </TableColumnItem>
              <TableColumnItem>
                <ScriptBlock>$_.LabelEvidence -join ', '</ScriptBlock>
              </TableColumnItem>
            </TableColumnItems>
          </TableRowEntry>
        </TableRowEntries>
      </TableControl>
    </View>
  </ViewDefinitions>
</Configuration>
